POSTGRES_PASSWORD=career_local
POSTGRES_DB=career
POSTGRES_PORT=55433
DATABASE_URL=postgresql+psycopg://career:career_local@localhost:55433/career
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
